                  "idempotency_unavailable",
                  "internal_error",
                  "knowledge_unavailable",
                  "method_not_allowed",
                  "metrics_forbidden",
                  "not_found",
                  "policy_busy",
                  "policy_unavailable",
                  "project_not_allowed",
                  "query_invalid",
                  "rate_limited",
                  "request_budget_exceeded",
                  "retrieve_timeout",
                  "rule_set_unavailable",
                  "schema_version_missing",
