  "info": {
    "summary": "把规则、检索与验证能力服务化；判定仍由核心 Policy Engine 做。",
    "title": "Engineering Policy Platform API",
    "version": "1.0",
    "x-api-schema-version": "1.0",
    "x-decision-schema-version": "1.0",
    "x-policy-generation": "phase-1",
    "x-service-version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health/live": {
      "get": {
        "description": "进程活着：不加载规则、不碰索引、不读日志——那些是 readiness 的事。",
        "operationId": "healthLive",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "description": "能安全提供策略服务：规则 / 索引 / 验证器 / 观测日志逐项检查。",
        "operationId": "healthReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "readiness 报告（state 是权威字段）"
          },
          "503": {
            "description": "readiness 报告（state 是权威字段）"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    },
