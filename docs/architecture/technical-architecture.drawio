          <mxGeometry x="80" y="400" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2a3" value="chunker（按标题分块，超长再切）→ SQLite FTS5 索引&amp;#xa;documents / chunks（heading_path · heading_anchor · text_hash）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2d2" value="② 规则溯源可解析？（登记了 rule_sources 时强制）&amp;#xa;dataset 已声明？文档已索引？heading_path 在原文中存在？" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="800" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2a4" value="人工 / 受控提炼：三层规范模型&amp;#xa;Raw Reference → Curated Guidance → Project Policy&amp;#xa;只有 Project Policy 允许阻断执行" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="930" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2a5" value="policies/&lt;domain&gt;/&lt;ID&gt;.yaml（规则文件，数据）&amp;#xa;id · version · name · description · scope · severity ·&amp;#xa;enforcement{type, checker} · rule{…} · message · source{kind, path}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="1090" width="800" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2d3" value="③ loader 加载门禁（原子：任一失败即不替换规则集）&amp;#xa;结构 · id 形状 · scope 维度 · severity · enforcement ·&amp;#xa;规则体与 checker 一致 · source.kind · 重复 ID" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="1260" width="800" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2a6" value="RuleSet（不可变 · 按路径稳定排序 · identity = sha256:…）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="80" y="1470" width="800" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2a7" value="policy.engine.evaluate（唯一判定路径）&amp;#xa;＋ PolicyContext（显式字段）＋ EvidenceBundle（验证器证据）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="1600" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2a8" value="Decision：allow / allow_with_warnings / block&amp;#xa;（需要人工审批时 block ＋ required_action = approval）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="1760" width="800" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2a9" value="Phase 4 受控执行恰好一次 · Phase 7 API · Phase 8 编排&amp;#xa;＋ 审计链 · 授权台账 · 阶段证据（可重放）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="1900" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2note" value="三层规范模型（决定“能不能阻断”）&amp;#xa;&amp;#xa;1. Raw Reference：离线镜像原文，只用于追溯、再提炼与评审；&amp;#xa;   其中的网页指令、代码与示例不得直接触发工具。&amp;#xa;2. Curated Guidance：从官方文档提炼的评审建议，默认只用于检索与解释，&amp;#xa;   不自动阻断（tier = guidance）。&amp;#xa;3. Project Policy：明确采纳 ＋ 稳定 ID/版本/适用范围/严重级别/执行器&amp;#xa;   ＋ 可验证测试，才成为可阻断的机器可执行规则。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="540" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p2x1" value="① 失败 → retrieval.cli verify 退出 1&amp;#xa;条目不在 manifest、许可声明文件缺失 → 加载失败；&amp;#xa;sha256 / 字节数漂移 → 写进 document 行、run 报告与&amp;#xa;漂移清单（CI 硬门禁），绝不静默继续。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="940" y="400" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2x2" value="② 失败 → 索引 run 标记 failed&amp;#xa;rule_sources 指向未索引文档、或标题路径在原文中&amp;#xa;不存在 → 抛 IndexingError（不静默跳过）；&amp;#xa;进程中断留下的 running 会在下次 run 标成 interrupted。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="940" y="740" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2x3" value="③ 失败 → RuleFileError / LoaderError，退出码 2（只有 YAML 语法错误带 行:列）&amp;#xa;规则集加载是原子的：任一文件失败都不替换现有规则集；&amp;#xa;同一 id 重复定义直接拒绝（语义变更必须递增 version，&amp;#xa;而不是并存两份）。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="940" y="1260" width="540" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2x4" value="判定侧的失败关闭（绝不会“默认放行”）&amp;#xa;&amp;#xa;· 证据类 checker 没有 EvidenceBundle → 记进 skipped_rules；&amp;#xa;  Phase 6 写类动作没有 evidence provider → evidence_unavailable 阻断。&amp;#xa;· 关键验证器缺失 / 版本不符 / 超时 / 崩溃 / 配置错误 /&amp;#xa;  输出非法 → 需要它的规则以 critical 阻断（同批 PASS 抵消不了）。&amp;#xa;· 本次运行的证据包没有为某个 checker 产出证据 → uncovered_checker_violation（critical）阻断。&amp;#xa;· 未知 checker / 未知 scope 维度 / 未知操作枚举 / 未知协议版本&amp;#xa;  → 加载或消费阶段报错。&amp;#xa;· “解析失败”不等于“没有依赖”：语法错误、动态 import 目标不是&amp;#xa;  常量、项目内模块解析失败，一律阻断。&amp;#xa;· 超时 / 服务不可达 / 规则集读不出来，只会更严（不会 allow）。" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="940" y="1600" width="540" height="410" as="geometry" />
        </mxCell>
        <mxCell id="p2e0" value="登记入口" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2a1" target="p2a2">
