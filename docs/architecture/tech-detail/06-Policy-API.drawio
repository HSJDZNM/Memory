        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F6368" value="API 只做协议 → 领域模型 → 协议；判定仍只有一条路径" vertex="1">
