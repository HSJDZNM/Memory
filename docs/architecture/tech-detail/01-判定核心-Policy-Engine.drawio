        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5F6368" value="唯一入口 policy.engine.evaluate；相同输入必须得到相同结论" vertex="1">
          <mxGeometry height="24" width="1160" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="rs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;规则集就绪&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;RuleSet.identity（与加载顺序无关）&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="600" x="120.0" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;上下文规范化&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;normalize_context · 只接受显式字段&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="600" x="120.0" y="190" as="geometry" />
        </mxCell>
        <mxCell id="match" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;范围匹配&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;matching_rules · 同维 OR / 跨维 AND&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="600" x="120.0" y="280" as="geometry" />
        </mxCell>
        <mxCell id="skip" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0B400;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;跳过要写原因&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;skipped_rules（skipped ≠ 通过）&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="600" x="120.0" y="370" as="geometry" />
        </mxCell>
        <mxCell id="ev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DA;strokeColor=#E0B400;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;证据门禁&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;blocker_for / serves(checker)&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="600" x="120.0" y="460" as="geometry" />
        </mxCell>
        <mxCell id="disp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;checker 分派&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;checker_handler(checker)&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="600" x="120.0" y="550" as="geometry" />
        </mxCell>
        <mxCell id="sort" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;strokeWidth=2;fontSize=16;fontColor=#1F2328;arcSize=14;" value="&lt;b&gt;违规稳定排序&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#5F6368'&gt;violations.sort(rule_id)&lt;/font&gt;" vertex="1">
