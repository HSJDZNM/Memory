  <diagram id="01-判定核心-Policy-Engine" name="单技术：Policy Engine 内部流程">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
