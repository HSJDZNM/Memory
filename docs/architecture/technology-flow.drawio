        <mxCell id="n4_1" value="Policy Engine（纯 Python）&amp;#xa;匹配与决策聚合；无 IO、无网络、无 LLM" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="s4"><mxGeometry x="20" y="52" width="320" height="110" as="geometry"/></mxCell>
