        <mxCell id="n5_2" value="FastAPI + uvicorn&amp;#xa;HTTP / OpenAPI 快照（httpx 做契约测试）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s5"><mxGeometry x="20" y="182" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="n5_3" value="LangGraph 1.2（消费者）&amp;#xa;唯一导入点；延迟导入 + 版本校验" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s5"><mxGeometry x="20" y="312" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="s6" value="⑥ 工程与验证链路（每次改动都要走）" style="swimlane;startSize=36;html=1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fbfbfb;strokeColor=#9e9e9e;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="1960" height="178" as="geometry"/></mxCell>
        <mxCell id="g1" value="pytest 9：四层测试&amp;#xa;单元 / 契约 / 集成 / 对抗（1110 passed）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="s6"><mxGeometry x="20" y="52" width="465" height="110" as="geometry"/></mxCell>
