        <mxCell id="s3" value="③ 存储与检索" style="swimlane;startSize=36;html=1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fbfbfb;strokeColor=#9e9e9e;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="360" height="450" as="geometry"/></mxCell>
        <mxCell id="n3_1" value="SQLite FTS5（sqlite3 标准库）&amp;#xa;检索索引：文档 / 片段 / 规则溯源" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="s3"><mxGeometry x="20" y="52" width="320" height="110" as="geometry"/></mxCell>
