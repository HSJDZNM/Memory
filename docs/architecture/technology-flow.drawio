        <mxCell id="f6" value="证据 / 台账写回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s4" target="s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="108"/><mxPoint x="1060" y="108"/></Array></mxGeometry></mxCell>
        <mxCell id="f7" value="门禁：0 / 1 / 2 退出码" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.72;exitY=0;exitDx=0;exitDy=0;entryX=0.72;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="note" value="依赖边界（AGENTS.md 的硬约束）：src/policy 只依赖标准库 + pydantic + PyYAML；Web 框架只在 src/policy_api，工作流框架只在 src/orchestration（构造引擎时才延迟导入）——删掉编排层或服务层，判定核心照常独立运行。外部工具（Ruff / pytest / mypy）不是包依赖，由探针发现，缺失即失败关闭。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#444444;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9e9e9e;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="852" width="1960" height="72" as="geometry"/></mxCell>
