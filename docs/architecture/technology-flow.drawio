      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tt1" value="Memory 仓库技术流程架构：从输入到结论用到什么技术" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="80" y="14" width="1960" height="36" as="geometry"/></mxCell>
        <mxCell id="tt2" value="颜色 = 依赖性质：绿 = 标准库 / 纯 Python；橙 = 第三方依赖（pip 安装）；蓝 = 本仓库自研代码；灰 = 数据文件与外部工具" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b6b6b;" vertex="1" parent="1"><mxGeometry x="80" y="50" width="1960" height="24" as="geometry"/></mxCell>
        <mxCell id="s1" value="① 输入（都是数据）" style="swimlane;startSize=36;html=1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fbfbfb;strokeColor=#9e9e9e;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="360" height="450" as="geometry"/></mxCell>
        <mxCell id="n1_1" value="YAML 数据文件&amp;#xa;规则 · 摄取清单 · 工具授权表 · 项目档案" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="s1"><mxGeometry x="20" y="52" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="n1_2" value="Markdown 离线镜像 + manifest.json&amp;#xa;6 套官方文档 + sha256 溯源" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="s1"><mxGeometry x="20" y="182" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="n1_3" value="事件 / 请求 JSON&amp;#xa;Hook stdin · API 请求体 · 执行请求" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="s1"><mxGeometry x="20" y="312" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="s2" value="② 解析与建模" style="swimlane;startSize=36;html=1;fontSize=13;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;fillColor=#fbfbfb;strokeColor=#9e9e9e;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="360" height="450" as="geometry"/></mxCell>
        <mxCell id="n2_1" value="PyYAML 6&amp;#xa;safe_load 解析；解析失败即报错" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="s2"><mxGeometry x="20" y="52" width="320" height="110" as="geometry"/></mxCell>
